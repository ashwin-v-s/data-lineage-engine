# Copy to .env (never commit .env). Use the shared Supabase project's pooler URI
# from Project Settings -> Database -> Connection string -> URI (Transaction pooler).
# This is Supabase-hosted Postgres, not a local PostgreSQL installation.
DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME@POOLER_HOST:6543/postgres?sslmode=require
KAIROS_ENV=development
KAIROS_LOG_LEVEL=INFO
# Public client configuration for Supabase Auth (safe to expose in the browser).
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Backend authentication verification. Keep this server-side value out of VITE_* variables.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
FRONTEND_ORIGIN=http://localhost:3000
# Optional, only if the Neo4j decision gate (D-06) is passed:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=CHANGE_ME
