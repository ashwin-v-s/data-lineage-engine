# Copy to .env (never commit .env, and never fill in real values here).
# Use the shared Supabase project's settings from Project Settings in the
# Supabase dashboard. See docs/DEPLOYMENT.md and docs/SUPABASE_SETUP.md.
# Each line below notes whether the variable is a SECRET.

# SECRET: Supabase Postgres transaction-pooler URI (contains the DB password).
# Project Settings -> Database -> Connection string -> URI (Transaction pooler).
# This is Supabase-hosted Postgres, not a local PostgreSQL installation.
DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME@POOLER_HOST:6543/postgres?sslmode=require

# NOT A SECRET: reserved label; not read by the current application code.
KAIROS_ENV=development
# NOT A SECRET: reserved log level; not read by the current application code.
KAIROS_LOG_LEVEL=INFO

# NOT A SECRET: public Supabase project URL (safe to expose in the browser).
# Read by the backend as a fallback for SUPABASE_URL only.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
# NOT A SECRET: publishable/anon key (safe to expose in the browser).
# Read by the backend as a fallback for SUPABASE_PUBLISHABLE_KEY only.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# NOT A SECRET: public Supabase project URL used for backend token verification.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# NOT A SECRET: publishable/anon key sent to Supabase as the apikey header.
# Never use the service_role key here.
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# NOT A SECRET: exact browser origin allowed by CORS (scheme + host, no trailing slash).
FRONTEND_ORIGIN=http://localhost:3000

# NOT A SECRET: opt-in flag for live integration tests. Set to 1 (with
# DATABASE_URL and SUPABASE_URL) to run tests against the shared project;
# leave unset to run the offline suite only.
KAIROS_LIVE_API_TESTS=

# SECRET: AES-256-GCM key (urlsafe base64 of exactly 32 random bytes) used to
# encrypt GitHub App installation tokens at rest and to sign install/callback
# state. Required before enabling the private-repository connector. Generate
# with: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
KAIROS_TOKEN_ENCRYPTION_KEY=

# SECRET (GITHUB_APP_PRIVATE_KEY): GitHub App credentials for the private
# read-only repository connector. All six are required together; leave unset
# unless the connector is being enabled. See docs/GITHUB_REPOSITORY_CONNECTOR.md.
GITHUB_APP_ID=
# Paste the .pem contents on one line; literal \n escapes are accepted.
GITHUB_APP_PRIVATE_KEY=
# NOT A SECRET: public app slug shown in install URLs (e.g. kairos-connector).
GITHUB_APP_SLUG=
# NOT A SECRET: OAuth client id of the same GitHub App.
GITHUB_APP_CLIENT_ID=
# SECRET: OAuth client secret of the same GitHub App.
GITHUB_APP_CLIENT_SECRET=
# NOT A SECRET: exact callback URL registered on the GitHub App.
GITHUB_APP_CALLBACK_URL=

# SECRET (NEO4J_PASSWORD): optional, only if the Neo4j decision gate (D-06) is passed.
# Not read by the current application code.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=CHANGE_ME
