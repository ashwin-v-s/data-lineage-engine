{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "backend/api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{data/**,docs/**,tests/**,references/**,**/*.zip}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend/api/index.py" },
    { "source": "/ingestion.html", "destination": "/backend/api/index.py" }
  ]
}
