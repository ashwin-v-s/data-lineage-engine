{
    "outputDirectory":  "frontend/dist",
    "buildCommand":  "npm --prefix frontend ci \u0026\u0026 npm --prefix frontend run build",
    "rewrites":  [
                     {
                         "destination":  "/backend/api/index.py",
                         "source":  "/healthz"
                     },
                     {
                         "destination":  "/backend/api/index.py",
                         "source":  "/api/(.*)"
                     },
                     {
                         "destination":  "/backend/api/index.py",
                         "source":  "/ingestion.html"
                     }
                 ],
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "functions":  {
                      "backend/api/index.py":  {
                                                   "runtime":  "python3.12",
                                                   "maxDuration":  30,
                                                   "entrypoint":  "backend/api/index.py",
                                                   "excludeFiles":  "{data/**,docs/**,tests/**,references/**,**/*.zip}"
                                               }
                  }
}
