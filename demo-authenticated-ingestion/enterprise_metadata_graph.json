      "kind": "source",
      "metadata": {
        "description": "Raw customer account records synchronized from core enterprise ERP and authentication service.",
        "owner": "data-engineering",
        "steward": "data-governance-officer",
        "tags": ["enterprise", "raw", "pii", "sox-in-scope"],
        "domain": "Customer Management",
        "compliance_context": "GDPR / CCPA Regulated",
        "policies": "Role-Based Access Control (RBAC) + Column Masking",
        "retention": "7 Years (Financial Audit Standard)",
        "columns": [
          {"name": "customer_id", "data_type": "uuid", "description": "Global unique identifier for customer account", "pii": false},
          {"name": "email", "data_type": "text", "description": "Customer primary email address", "pii": true, "classification": "PII_SOURCE"},
          {"name": "full_name", "data_type": "text", "description": "Full customer legal name", "pii": true, "classification": "PII_SOURCE"},
          {"name": "phone_number", "data_type": "varchar", "description": "Customer mobile phone number with country code", "pii": true, "classification": "PII_SOURCE"},
          {"name": "country_code", "data_type": "varchar", "description": "ISO-3166-1 alpha-2 country code", "pii": false},
          {"name": "created_at", "data_type": "timestamptz", "description": "Account registration timestamp", "pii": false}
        ]
      }
    },
    {
      "id": "raw-ord-02",
      "name": "orders_feed",
      "namespace": "raw_enterprise",
      "type": "table",
      "kind": "source",
      "metadata": {
        "description": "Raw immutable stream of e-commerce checkout events captured from store frontends.",
        "owner": "data-engineering",
        "steward": "finance-steward",
        "tags": ["enterprise", "raw", "orders", "sox-in-scope"],
        "domain": "Finance & Revenue",
        "compliance_context": "SOX Section 404 In-Scope",
        "policies": "Immutable append-only audit trail",
        "retention": "7 Years (Financial Audit Standard)",
        "columns": [
          {"name": "order_id", "data_type": "uuid", "description": "Primary order transaction identifier", "pii": false},
          {"name": "customer_id", "data_type": "uuid", "description": "Foreign key reference to customer record", "pii": false},
          {"name": "order_status", "data_type": "varchar", "description": "Current lifecycle status (PENDING, PAID, FULFILLED, REFUNDED)", "pii": false},
          {"name": "order_amount_usd", "data_type": "numeric", "description": "Gross order value in USD before discounts", "pii": false},
          {"name": "tax_amount_usd", "data_type": "numeric", "description": "Sales tax or VAT assessed on order", "pii": false},
          {"name": "order_timestamp", "data_type": "timestamptz", "description": "Timestamp when customer submitted order", "pii": false}
        ]
      }
    },
    {
      "id": "raw-pay-03",
      "name": "payments_feed",
      "namespace": "raw_enterprise",
      "type": "table",
      "kind": "source",
      "metadata": {
        "description": "Raw payment webhook records received from global payment gateway acquirers.",
        "owner": "payments-infra",
        "steward": "finance-steward",
        "tags": ["enterprise", "raw", "payments", "sox-in-scope"],
        "domain": "Finance & Revenue",
        "compliance_context": "PCI-DSS / SOX In-Scope",
        "policies": "Tokenized settlement IDs; zero raw cardholder data stored",
        "retention": "7 Years (Financial Audit Standard)",
        "columns": [
          {"name": "payment_id", "data_type": "uuid", "description": "Unique payment gateway authorization ID", "pii": false},
          {"name": "order_id", "data_type": "uuid", "description": "Foreign key reference to order_feed.order_id", "pii": false},
          {"name": "payment_method", "data_type": "varchar", "description": "Settlement tender type (CARD, WIRE, ACH)", "pii": false},
          {"name": "payment_status", "data_type": "varchar", "description": "Gateway status (SETTLED, CAPTURED, FAILED, CHARGEBACK)", "pii": false},
          {"name": "settled_amount_usd", "data_type": "numeric", "description": "Net currency funds received in bank settlement", "pii": false},
          {"name": "settled_at", "data_type": "timestamptz", "description": "Bank ledger settlement timestamp", "pii": false}
        ]
      }
    },
    {
      "id": "stg-ord-04",
      "name": "stg_orders_enriched",
      "namespace": "staging",
      "type": "view",
      "kind": "transform",
      "metadata": {
        "description": "Cleansed and reconciled order records joined with payment settlement status for downstream marts.",
        "owner": "analytics-engineering",
        "steward": "finance-steward",
        "tags": ["enterprise", "staging", "dbt", "sox-in-scope"],
        "domain": "Finance & Revenue",
        "compliance_context": "SOX Section 404 In-Scope",
        "policies": "Automated dbt test assertions on primary key and foreign keys",
        "retention": "3 Years Rolling",
        "columns": [
          {"name": "order_id", "data_type": "uuid", "description": "Conformed order identifier", "pii": false},
          {"name": "customer_id", "data_type": "uuid", "description": "Conformed customer reference identifier", "pii": false},
          {"name": "order_status", "data_type": "varchar", "description": "Normalized order lifecycle status", "pii": false},
          {"name": "gross_order_value", "data_type": "numeric", "description": "Order subtotal plus tax in USD", "pii": false},
          {"name": "net_settled_value", "data_type": "numeric", "description": "Net settled payment funds received", "pii": false},
          {"name": "is_settled", "data_type": "boolean", "description": "Flag indicating full payment settlement", "pii": false},
          {"name": "order_timestamp", "data_type": "timestamptz", "description": "Order placement timestamp", "pii": false}
        ],
        "column_mappings": [
          {"source_column": "raw_enterprise.orders_feed.order_id", "target_column": "staging.stg_orders_enriched.order_id", "transformation": "IDENTITY", "evidence_type": "dbt_ref"},
          {"source_column": "raw_enterprise.orders_feed.customer_id", "target_column": "staging.stg_orders_enriched.customer_id", "transformation": "IDENTITY", "evidence_type": "dbt_ref"},
          {"source_column": "raw_enterprise.orders_feed.order_amount_usd", "target_column": "staging.stg_orders_enriched.gross_order_value", "transformation": "COALESCE(order_amount_usd + tax_amount_usd, 0)", "evidence_type": "dbt_ref"},
          {"source_column": "raw_enterprise.payments_feed.settled_amount_usd", "target_column": "staging.stg_orders_enriched.net_settled_value", "transformation": "COALESCE(settled_amount_usd, 0)", "evidence_type": "dbt_ref"}
        ]
      }
    },
    {
      "id": "stg-cust-05",
      "name": "stg_customer_360",
      "namespace": "staging",
      "type": "view",
      "kind": "transform",
      "metadata": {
        "description": "Anonymized conformed customer dimension with SHA-256 masked emails and regional standardization.",
        "owner": "analytics-engineering",
        "steward": "data-governance-officer",
        "tags": ["enterprise", "staging", "dbt", "pii-masked"],
        "domain": "Customer Management",
        "compliance_context": "GDPR Article 32 Masked View",
        "policies": "Anonymized analytics access; unmasked view restricted to compliance auditor role",
        "retention": "3 Years Rolling",
        "columns": [
          {"name": "customer_id", "data_type": "uuid", "description": "Conformed customer unique identifier", "pii": false},
          {"name": "masked_email", "data_type": "text", "description": "One-way HMAC-SHA256 salted hash of customer email", "pii": true, "classification": "PII_MASKED"},
          {"name": "country_code", "data_type": "varchar", "description": "Normalized ISO country code", "pii": false},
          {"name": "customer_tier", "data_type": "varchar", "description": "Customer tier classification (STANDARD, GOLD, ENTERPRISE)", "pii": false},
          {"name": "registered_date", "data_type": "date", "description": "Account creation date", "pii": false}
        ],
        "column_mappings": [
          {"source_column": "raw_enterprise.customers.customer_id", "target_column": "staging.stg_customer_360.customer_id", "transformation": "IDENTITY", "evidence_type": "dbt_ref"},
          {"source_column": "raw_enterprise.customers.email", "target_column": "staging.stg_customer_360.masked_email", "transformation": "SHA256_MASK(email)", "evidence_type": "dbt_ref"},
          {"source_column": "raw_enterprise.customers.country_code", "target_column": "staging.stg_customer_360.country_code", "transformation": "UPPER(TRIM(country_code))", "evidence_type": "dbt_ref"}
        ]
      }
    },
    {
