        "product": "Executive Revenue Intelligence Product",
        "compliance_context": "SOX Section 404 Critical Financial Mart",
        "policies": "Daily freshness SLA: 24h; strict schema immutability",
        "retention": "7 Years (Statutory Reporting)",
        "columns": [
          {"name": "accounting_date", "data_type": "date", "description": "Financial accounting reporting date", "pii": false},
          {"name": "gross_merchandise_value", "data_type": "numeric", "description": "Sum of all placed order values (GMV)", "pii": false},
          {"name": "net_recognized_revenue", "data_type": "numeric", "description": "Net GAAP revenue recognized from settled transactions", "pii": false},
          {"name": "total_orders_count", "data_type": "integer", "description": "Total count of order transactions processed", "pii": false},
          {"name": "unique_customers_count", "data_type": "integer", "description": "Count of distinct active purchasers", "pii": false},
          {"name": "calculated_at", "data_type": "timestamptz", "description": "ETL calculation execution timestamp", "pii": false}
        ],
        "column_mappings": [
          {"source_column": "staging.stg_orders_enriched.gross_order_value", "target_column": "analytics.fct_daily_revenue.gross_merchandise_value", "transformation": "SUM(gross_order_value)", "evidence_type": "dbt_ref"},
          {"source_column": "staging.stg_orders_enriched.net_settled_value", "target_column": "analytics.fct_daily_revenue.net_recognized_revenue", "transformation": "SUM(net_settled_value)", "evidence_type": "dbt_ref"},
          {"source_column": "staging.stg_orders_enriched.order_id", "target_column": "analytics.fct_daily_revenue.total_orders_count", "transformation": "COUNT(DISTINCT order_id)", "evidence_type": "dbt_ref"}
        ]
      }
    },
